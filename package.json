{
  "name": "armazem-trote",
  "version": "0.1.0",
  "private": true,
  "description": "Armaz\u00e9m Trote & Cia \u2014 secos & molhados entregues no ritmo do casco.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm infra:up && pnpm db:migrate && pnpm db:seed --if-empty && concurrently -k -n web,worker -c yellow,cyan \"next dev\" \"pnpm worker:dev\"",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server src/jobs/worker.ts",
    "worker:dev": "tsx watch --conditions=react-server src/jobs/worker.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server db/migrate.ts",
    "db:seed": "tsx --conditions=react-server db/seed/index.ts",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:load": "node -e \"const m=require('./.next/server/server-reference-manifest.json');process.stdout.write(Object.entries(m.node).find(([,v])=>v.exportedName==='addToCartAction')[0])\" | xargs -I{} docker run --rm -i --add-host=host.docker.internal:host-gateway -v \"$PWD/tests/load:/load\" -e BASE_URL=${BASE_URL:-http://host.docker.internal:3000} -e ADD_TO_CART_ACTION={} grafana/k6 run /load/k6.js",
    "db:explain": "docker compose exec -T postgres psql -U trote -d armazem -f - < db/query-plans.sql"
  },
  "dependencies": {
    "bullmq": "6.3.11",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "next": "16.4.0",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
