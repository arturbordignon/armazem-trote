# Copy to .env — every value is validated on boot (src/lib/env.ts).

NODE_ENV=development
LOG_LEVEL=debug

# Pooled connection used by the app. Behind PgBouncer (transaction mode) use port 6432
# and set DATABASE_PREPARED_STATEMENTS=false.
DATABASE_URL=postgres://trote:trote@localhost:5434/armazem
# Direct connection for migrations and seeding (never through a transaction pooler).
DATABASE_URL_DIRECT=postgres://trote:trote@localhost:5434/armazem
DATABASE_POOL_MAX=10
DATABASE_PREPARED_STATEMENTS=true
# Log every SQL statement with the request id (use it to spot N+1 queries).
DATABASE_LOG_QUERIES=false

# Integration tests run migrations against this database (created automatically).
TEST_DATABASE_URL=postgres://trote:trote@localhost:5434/armazem_test
# Integration tests flush this Redis database (index 1), never the development one (0).
TEST_REDIS_URL=redis://localhost:6380/1

REDIS_URL=redis://localhost:6380

# Signs the guest-cart cookie. At least 32 characters.
CART_COOKIE_SECRET=change-me-to-a-long-random-string-0123456789

# Bearer token for PATCH /api/admin/produtos/{slug} (reprice/restock). Unset = API disabled.
ADMIN_API_TOKEN=local-admin-token-change-me-0123456789abcdef
